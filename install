#!/bin/sh
# Link this checkout into every agent harness. It must live at
# ~/.agents/skills, where Codex, OpenCode and ZCode find skills on their own.
# Safe to re-run, and re-run it after adding or removing a skill.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "$here" != "$HOME/.agents/skills" ]; then
	echo "install: clone this repository to ~/.agents/skills first" >&2
	exit 1
fi

# link TARGET NAME: point NAME at TARGET. Anything else already at NAME, even a
# symlink to somewhere else, is left alone for you to move aside.
link() {
	if [ -L "$2" ] && [ "$(readlink -f "$2")" = "$(readlink -f "$1")" ]; then
		return
	elif [ -e "$2" ] || [ -L "$2" ]; then
		echo "install: $2 is in the way; move it aside and re-run" >&2
		exit 1
	fi
	mkdir -p "$(dirname "$2")"
	ln -s "$1" "$2"
	echo "$2 -> $1"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md" # OpenCode falls back to this too
link "$here/AGENTS.md" "$HOME/.codex/AGENTS.md"
link "$here/AGENTS.md" "$HOME/.zcode/AGENTS.md"

# Claude Code only reads ~/.claude/skills, and keeps its own claude.ai skill
# cache in there (synced/), so link each skill rather than the whole directory.
for skill in "$here"/*/SKILL.md; do
	skill=${skill%/SKILL.md}
	link "$skill" "$HOME/.claude/skills/${skill##*/}"
done
for old in "$HOME"/.claude/skills/*; do
	case $(readlink "$old" || true) in
	"$here"/*) [ -e "$old" ] || { rm "$old"; echo "removed $old"; } ;;
	esac
done
