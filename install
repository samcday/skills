#!/bin/sh
# Link AGENTS.md into every agent harness's global-instructions path. Safe to
# re-run. Skills are not handled here: `npx skills add samcday/skills -g`
# installs them into ~/.agents/skills and symlinks them into each harness.
set -eu

here=$(cd "$(dirname "$0")" && pwd)

# link TARGET NAME: point NAME at TARGET. Anything else already at NAME, even a
# symlink to somewhere else, is left alone for you to move aside.
link() {
	if [ -L "$2" ] && [ "$(readlink -f "$2")" = "$(readlink -f "$1")" ]; then
		return
	elif [ -e "$2" ] || [ -L "$2" ]; then
		echo "install: $2 is in the way; move it aside and re-run" >&2
		exit 1
	fi
	mkdir -p "$(dirname "$2")"
	ln -s "$1" "$2"
	echo "$2 -> $1"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md" # OpenCode falls back to this too
link "$here/AGENTS.md" "$HOME/.codex/AGENTS.md"
link "$here/AGENTS.md" "$HOME/.zcode/AGENTS.md"

if [ -n "${DELTA_CONFIG_DIR:-}" ]; then
	delta_config_dir=$DELTA_CONFIG_DIR
elif [ "$(uname -s)" = Darwin ]; then
	delta_config_dir="$HOME/.config/delta"
else
	delta_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/delta"
fi
link "$here/AGENTS.md" "$delta_config_dir/AGENTS.md"
