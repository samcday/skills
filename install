#!/bin/sh
# Link this checkout into every agent harness. It must live at
# ~/.agents/skills, where Codex, OpenCode and ZCode find skills on their own.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
if [ "$here" != "$HOME/.agents/skills" ]; then
	echo "install: clone this repository to ~/.agents/skills first" >&2
	exit 1
fi

# link TARGET NAME: point NAME at TARGET, replacing an old symlink but never a
# real file or directory.
link() {
	if [ -L "$2" ]; then
		rm "$2"
	elif [ -e "$2" ]; then
		echo "install: $2 exists and is not a symlink; move it aside first" >&2
		exit 1
	fi
	mkdir -p "$(dirname "$2")"
	ln -s "$1" "$2"
	echo "$2 -> $1"
}

link "$here/AGENTS.md" "$HOME/.claude/CLAUDE.md" # OpenCode falls back to this too
link "$here/AGENTS.md" "$HOME/.codex/AGENTS.md"
link "$here/AGENTS.md" "$HOME/.zcode/AGENTS.md"
link "$here" "$HOME/.claude/skills"
